# NexCode — env template (no real secrets here)
# Copy to .env.local and fill in. Current .env.local uses HASHED placeholders.

# Nebius (Token Factory / AI Cloud, OpenAI-compatible)
NEBIUS_API_KEY=HASHED_REPLACE_ME
NEBIUS_BASE_URL=https://api.studio.nebius.com/v1
# Exact IDs depend on live Token Factory catalog — verify before demo.
NEBIUS_MODEL_ARCHITECT=HASHED_NVIDIA_REASONING_MODEL
NEBIUS_MODEL_BUILDER=HASHED_NVIDIA_CODE_MODEL
NEBIUS_MODEL_VERIFIER=HASHED_NVIDIA_REVIEW_MODEL
NEBIUS_MODEL_FAST=HASHED_NVIDIA_FAST_MODEL

# Tavily
TAVILY_API_KEY=HASHED_REPLACE_ME
TAVILY_MAX_CALLS_PER_TASK=3

# GitHub OAuth (NextAuth)
GITHUB_ID=HASHED_REPLACE_ME
GITHUB_SECRET=HASHED_REPLACE_ME
NEXTAUTH_SECRET=HASHED_REPLACE_ME
NEXTAUTH_URL=http://localhost:3000

# Sandbox mode: "local" (MVP) | "nebius" (when Sandbox API is wired)
SANDBOX_MODE=local
